#!/usr/bin/env python3
"""getytcc — fetch a YouTube video's captions (and description) into a folder.

Usage:
    getytcc <youtube video url> [-l en,de] [-o DIR]
            [--only-srt | --only-txt | --only-desc]

By default writes two files into the current directory:
    <sanitized-title>_<videoId>.srt              (timestamped subtitles)
    <sanitized-title>_<videoId>_DESCRIPTION.txt  (the video's full description)

Available on request:
    <sanitized-title>_<videoId>.txt              (clean text, no timestamps)

Pure-Python, no binaries. Engine: youtube-transcript-api — whose InnerTube
player endpoint also carries the description, so no extra dependency is needed.
"""

import argparse
import json
import re
import sys
import urllib.error
import urllib.parse
import urllib.request
from pathlib import Path

try:
    from youtube_transcript_api import (
        YouTubeTranscriptApi,
        NoTranscriptFound,
    )
    from youtube_transcript_api._errors import CouldNotRetrieveTranscript
    from youtube_transcript_api.formatters import SRTFormatter, TextFormatter
except ModuleNotFoundError:
    sys.exit(
        "ERROR: youtube-transcript-api is not installed.\n"
        "Install it with:  pip install youtube-transcript-api\n"
        "(or run install.sh to set up the dedicated venv)."
    )

# --- Constants ---
ALLOWED_HOSTS = {
    "youtube.com",
    "www.youtube.com",
    "m.youtube.com",
    "music.youtube.com",
    "youtu.be",
    "www.youtu.be",
}
VIDEO_ID_RE = re.compile(r"^[A-Za-z0-9_-]{11}$")
DEFAULT_LANGS = "en,en-US,en-GB"
OEMBED_URL = "https://www.youtube.com/oembed"
HTTP_TIMEOUT = 10  # seconds
MAX_NAME_LEN = 100
# Browser-like UA for the watch page / InnerTube fetches used by the description.
BROWSER_USER_AGENT = "Mozilla/5.0 (Windows NT 10.0; Win64; x64)"
# Fallbacks if youtube-transcript-api ever moves these private constants.
FALLBACK_WATCH_URL = "https://www.youtube.com/watch?v={video_id}"
FALLBACK_INNERTUBE_API_URL = (
    "https://www.youtube.com/youtubei/v1/player?key={api_key}"
)
FALLBACK_INNERTUBE_CONTEXT = {
    "client": {"clientName": "ANDROID", "clientVersion": "20.10.38"}
}


def extract_video_id(url: str) -> str:
    """Return the 11-char video id from a YouTube URL, or raise ValueError.

    Accepts only YouTube hosts and these forms: watch?v=, youtu.be/<id>,
    /shorts/<id>, /embed/<id>, /live/<id>.
    """
    parts = urllib.parse.urlsplit(url.strip())
    host = parts.hostname.lower() if parts.hostname else ""
    if host not in ALLOWED_HOSTS:
        raise ValueError(f"Not a recognized YouTube URL (host: {host or 'none'!r}).")

    candidate = ""
    if host in {"youtu.be", "www.youtu.be"}:
        candidate = parts.path.lstrip("/").split("/", 1)[0]
    elif parts.path == "/watch":
        candidate = urllib.parse.parse_qs(parts.query).get("v", [""])[0]
    else:
        segments = [seg for seg in parts.path.split("/") if seg]
        if len(segments) >= 2 and segments[0] in {"shorts", "embed", "live", "v"}:
            candidate = segments[1]

    if not VIDEO_ID_RE.match(candidate):
        raise ValueError("Could not find a valid 11-character video id in the URL.")
    return candidate


def _http_get_text(url: str, data: bytes | None = None) -> str:
    """GET (or POST if `data` is given) and return the decoded body."""
    headers = {"User-Agent": BROWSER_USER_AGENT}
    if data is not None:
        headers["Content-Type"] = "application/json"
    request = urllib.request.Request(url, data=data, headers=headers)
    with urllib.request.urlopen(request, timeout=HTTP_TIMEOUT) as response:
        return response.read().decode("utf-8", "replace")


def fetch_title(video_id: str) -> str | None:
    """Fetch the video title via YouTube's oEmbed endpoint; None on any failure."""
    watch_url = f"https://www.youtube.com/watch?v={video_id}"
    query = urllib.parse.urlencode({"format": "json", "url": watch_url})
    request = urllib.request.Request(
        f"{OEMBED_URL}?{query}",
        headers={"User-Agent": "getytcc/1.0"},
    )
    try:
        with urllib.request.urlopen(request, timeout=HTTP_TIMEOUT) as response:
            data = json.loads(response.read().decode("utf-8"))
        title = data.get("title")
        return title if isinstance(title, str) and title.strip() else None
    except (urllib.error.URLError, json.JSONDecodeError, ValueError, OSError):
        return None


def fetch_description(video_id: str) -> str | None:
    """Return the video's full description, or None on any failure.

    Reuses the SAME InnerTube player endpoint youtube-transcript-api calls for
    captions; that JSON response also carries videoDetails.shortDescription.
    Imports the library's own endpoint constants so this tracks its maintenance
    (client version, url), falling back to local copies if that private module
    ever moves. This is not HTML-content scraping: the only thing lifted from
    the watch page is the public INNERTUBE_API_KEY, exactly as the library does.
    An empty description comes back as "" (not None) so the caller can tell an
    empty description apart from a fetch failure.
    """
    try:
        from youtube_transcript_api._settings import (
            WATCH_URL,
            INNERTUBE_API_URL,
            INNERTUBE_CONTEXT,
        )
    except Exception:
        WATCH_URL = FALLBACK_WATCH_URL
        INNERTUBE_API_URL = FALLBACK_INNERTUBE_API_URL
        INNERTUBE_CONTEXT = FALLBACK_INNERTUBE_CONTEXT

    try:
        html = _http_get_text(WATCH_URL.format(video_id=video_id))
        match = re.search(r'"INNERTUBE_API_KEY":\s*"([\w-]+)"', html)
        if not match:
            return None
        body = json.dumps(
            {"context": INNERTUBE_CONTEXT, "videoId": video_id}
        ).encode("utf-8")
        payload = _http_get_text(
            INNERTUBE_API_URL.format(api_key=match.group(1)), data=body
        )
        details = json.loads(payload).get("videoDetails", {})
        description = details.get("shortDescription")
        return description if isinstance(description, str) else None
    except (urllib.error.URLError, OSError, ValueError):
        return None


def sanitize_filename(name: str) -> str:
    """Make a string safe to use as a single filename component."""
    name = "".join(ch for ch in name if ch.isprintable())
    name = re.sub(r'[\\/:*?"<>|]', "", name)   # illegal / path-separator chars
    name = re.sub(r"[()\[\]{}]", "", name)      # drop brackets for cleaner names
    name = re.sub(r"\s+", "-", name.strip())    # whitespace -> dash
    name = re.sub(r"-{2,}", "-", name)          # collapse repeats
    name = name.strip("-.")                      # no leading/trailing dot or dash
    return name[:MAX_NAME_LEN]


def get_transcript(video_id: str, languages: list[str]):
    """Return a FetchedTranscript, preferring `languages`, else the first available."""
    transcript_list = YouTubeTranscriptApi().list(video_id)
    try:
        transcript = transcript_list.find_transcript(languages)
    except NoTranscriptFound:
        transcript = next(iter(transcript_list), None)
        if transcript is None:
            raise
    return transcript.fetch()


def parse_args(argv: list[str]) -> argparse.Namespace:
    parser = argparse.ArgumentParser(
        prog="getytcc",
        description="Fetch a YouTube video's captions (.srt) and description "
        "(_DESCRIPTION.txt) into the current folder.",
    )
    parser.add_argument("url", help="YouTube video URL")
    parser.add_argument(
        "-l", "--lang", default=DEFAULT_LANGS,
        help=f"Comma-separated language preference (default: {DEFAULT_LANGS}). "
        "Falls back to the first available transcript.",
    )
    parser.add_argument(
        "-o", "--outdir", default=".",
        help="Directory to write into (default: current folder).",
    )
    # By default getytcc writes the .srt and the _DESCRIPTION.txt. Each --only-*
    # flag restricts output to just that one file. The *-only names are kept as
    # aliases so older invocations keep working.
    group = parser.add_mutually_exclusive_group()
    group.add_argument(
        "--only-srt", "--srt-only", dest="only_srt", action="store_true",
        help="Write only the .srt (timestamped) file.",
    )
    group.add_argument(
        "--only-txt", "--txt-only", dest="only_txt", action="store_true",
        help="Write only the .txt (clean transcript, no timestamps) file.",
    )
    group.add_argument(
        "--only-desc", dest="only_desc", action="store_true",
        help="Write only the _DESCRIPTION.txt file.",
    )
    return parser.parse_args(argv)


def main(argv: list[str]) -> int:
    args = parse_args(argv)

    try:
        video_id = extract_video_id(args.url)
    except ValueError as exc:
        print(f"ERROR: {exc}", file=sys.stderr)
        return 2

    outdir = Path(args.outdir).expanduser().resolve()
    if not outdir.is_dir():
        print(f"ERROR: output directory does not exist: {outdir}", file=sys.stderr)
        return 2

    # Decide outputs. Default (no --only-* flag): the .srt and the description.
    only_one = args.only_srt or args.only_txt or args.only_desc
    want_srt = args.only_srt or not only_one
    want_txt = args.only_txt
    want_desc = args.only_desc or not only_one

    languages = [code.strip() for code in args.lang.split(",") if code.strip()]

    title = fetch_title(video_id)
    base = f"{sanitize_filename(title)}_{video_id}" if title else video_id
    if not base or base.startswith("_"):
        base = video_id

    written: list[Path] = []

    # Transcript — only fetch it if a transcript file is actually wanted.
    if want_txt or want_srt:
        try:
            fetched = get_transcript(video_id, languages)
        except CouldNotRetrieveTranscript as exc:
            print(f"ERROR: {str(exc).strip()}", file=sys.stderr)
            return 1
        if want_txt:
            txt_path = outdir / f"{base}.txt"
            with open(txt_path, "w", encoding="utf-8") as handle:
                handle.write(TextFormatter().format_transcript(fetched))
            written.append(txt_path)
        if want_srt:
            srt_path = outdir / f"{base}.srt"
            with open(srt_path, "w", encoding="utf-8") as handle:
                handle.write(SRTFormatter().format_transcript(fetched))
            written.append(srt_path)

    # Description — best effort, and never overwrite an existing file (it may
    # hold hand-added notes). A description failure does not fail the run unless
    # the description was the only thing asked for.
    desc_failed = False
    if want_desc:
        desc_path = outdir / f"{base}_DESCRIPTION.txt"
        if desc_path.exists():
            print(
                f"(kept existing {desc_path.name}; not overwritten)",
                file=sys.stderr,
            )
        else:
            description = fetch_description(video_id)
            if description is None:
                print(
                    "WARNING: could not fetch the description — paste it "
                    f"manually into {desc_path.name}.",
                    file=sys.stderr,
                )
                desc_failed = True
            else:
                with open(desc_path, "w", encoding="utf-8") as handle:
                    handle.write(description)
                written.append(desc_path)
                if description.strip() == "":
                    print(
                        f"(note: {desc_path.name} is empty — the video has no "
                        "description)",
                        file=sys.stderr,
                    )

    for path in written:
        print(path)

    if desc_failed and not written:
        return 1
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main(sys.argv[1:]))
    except KeyboardInterrupt:
        sys.exit(130)
